# ─── MESMS Backend — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your PostgreSQL credentials.

# ── Database (Local PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mesms"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change_this_to_a_long_random_secret_min_32_chars"
JWT_EXPIRES_IN="8h"

# ── Server URLs ───────────────────────────────────────────────────────────────
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
NODE_ENV=development

# ── Default Tenant (used in seed) ────────────────────────────────────────────
DEFAULT_TENANT_ID="tenant_medtech_01"
