# ─── MESMS Backend — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your MySQL 8+ credentials.

# ── Database (Authoritative: MySQL 8+) ────────────────────────────────────────
DATABASE_URL="mysql://mesms:YOUR_PASSWORD@localhost:3306/mesms"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change_this_to_a_long_random_secret_min_32_chars"
JWT_EXPIRES_IN="8h"

# ── Server URLs ───────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
NODE_ENV=development

# Private files are written outside the public web root.
PRIVATE_STORAGE_PATH="./storage/private"
MAX_UPLOAD_BYTES=10485760

# ── Default Tenant (used in seed) ────────────────────────────────────────────
DEFAULT_TENANT_ID="tenant_medtech_01"
